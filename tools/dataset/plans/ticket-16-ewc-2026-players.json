{
	"$comment": "Ticket 16: Esports World Cup 2026's player rows, re-read in a unique order. The first fetch ordered by GameId, which repeats ten times per game, so offset paging lost rows at the page boundary (measured: 2 320 rows exist, 2 000 were pinned and 32 games ended up with fewer than ten players). UniqueLine is the wiki's unique row key, so a page boundary cannot duplicate or skip one.",
	"queries": [
		{
			"endpoint": "cargoexport",
			"tables": "ScoreboardPlayers",
			"fields": "OverviewPage,Name,Link,Champion,Kills,Deaths,Assists,SummonerSpells,Gold,CS,DamageToChampions,VisionScore,Items,RoleBoundItem,Trinket,Pentakills,KeystoneMastery,KeystoneRune,PrimaryTree,SecondaryTree,Runes,TeamKills,TeamGold,Team,TeamVs,Time,PlayerWin,DateTime_UTC,DST,Tournament,Role,Role_Number,IngameRole,Side,UniqueLine,UniqueLineVs,UniqueRole,UniqueRoleVs,GameId,MatchId,GameTeamId,GameRoleId,GameRoleIdVs,StatsPage",
			"where": "OverviewPage LIKE 'Esports World Cup 2026%'",
			"order_by": "UniqueLine ASC",
			"limit": 2000
		},
		{
			"endpoint": "cargoexport",
			"tables": "ScoreboardPlayers",
			"fields": "OverviewPage,Name,Link,Champion,Kills,Deaths,Assists,SummonerSpells,Gold,CS,DamageToChampions,VisionScore,Items,RoleBoundItem,Trinket,Pentakills,KeystoneMastery,KeystoneRune,PrimaryTree,SecondaryTree,Runes,TeamKills,TeamGold,Team,TeamVs,Time,PlayerWin,DateTime_UTC,DST,Tournament,Role,Role_Number,IngameRole,Side,UniqueLine,UniqueLineVs,UniqueRole,UniqueRoleVs,GameId,MatchId,GameTeamId,GameRoleId,GameRoleIdVs,StatsPage",
			"where": "OverviewPage LIKE 'Esports World Cup 2026%'",
			"order_by": "UniqueLine ASC",
			"limit": 2000,
			"offset": 2000
		}
	]
}

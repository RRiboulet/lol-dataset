node_modules/
*.log
.DS_Store

# pi session state. Todos belong to a session, not to the project;
# .pi/settings.json is committed on purpose so a fresh clone is configured the
# same way (codemode + tool_search in defaultTools).
.pi/todos/
.pi/npm/

# Linked worktrees (see .pi/skills/worktree/). Shared refs, so branch names must
# stay unique across them.
.worktrees/

lab/

# Raw source payload cache (spec D6). Not committed: it is large, it duplicates
# third-party content, and the manifest plus body hashes pin it (spec R9).
# Ticket 01 commits its recorded fixtures under tools/dataset/fixtures/ instead.
# Anchored to the repository root on purpose: a bare `raw/` would also hide
# tools/dataset/fixtures/raw/, which is committed.
/raw/
